{
	// A CUSTOMER'S tsconfig. Note what is NOT here: no `paths`, no `baseUrl`, no reference to the
	// monorepo root. `@skinhub/viewer` resolves through `node_modules` and its `exports` map, so this
	// file typechecks against the package's PUBLISHED `.d.ts` rather than its source - which is the
	// only way to find out whether the published types are usable.
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2022", "dom", "dom.iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["bun"]
	},
	"include": ["app.tsx", "serve.ts"]
}
