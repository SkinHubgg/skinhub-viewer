{
	// The package is built and typechecked entirely on its own, deliberately: it must not be able to
	// reach anything in the SkinHub app. It used to live inside that monorepo as `packages/viewer`,
	// where "must not" was a rule this config enforced; it now lives in its own repository, where it
	// is a fact of the filesystem. The config is kept strict anyway — the app is a sibling checkout on
	// a developer's disk, and `../../app/apps/web/…` is still a specifier somebody could type.
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"types": ["bun"],

		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"exactOptionalPropertyTypes": false,
		"verbatimModuleSyntax": true,

		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"noEmit": true
	},
	"include": ["src", "test", "scripts"]
}
